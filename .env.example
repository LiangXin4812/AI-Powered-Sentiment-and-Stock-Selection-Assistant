# Existing PostgreSQL URL (SQLAlchemy psycopg2 format), with the project's populated Task 1–6 tables. Do not commit the real URL.
SUPABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
# Task 5 writer and the Task 7 AI text (Task 7 prints its template text without it).
GROQ_API_KEY=
# Only required if FinBERT must be fetched from Hugging Face.
HF_TOKEN=
# Optional local FinBERT directory mounted inside /app/cache.
FINBERT_MODEL_DIR=
# Optional: e-mail the daily report (run-all)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_TO=
